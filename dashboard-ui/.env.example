# ═══ Dashboard Environment Variables ═══
# Copy to .env.local and fill in

# BigQuery Dataset (REQUIRED for new project)
NEXT_PUBLIC_DATASET=STRAMARK_Dataset
NEXT_PUBLIC_BQ_PROJECT=levelup-465304

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WAR_ROOM_URL=http://localhost:8001

# Branding
NEXT_PUBLIC_APP_NAME=STRAMARK

# BigQuery credentials (server-side)  
DATASET=STRAMARK_Dataset

# ═══ Vercel Deployment (Cloud) ═══
# Paste the full JSON content of bigquery-key.json here
# BIGQUERY_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

# Paste the full content of config/projects/talpha.yaml here
# TALPHA_YAML="meta_ads:\n  access_token: ..."

# Google Sheets credentials (base64-encoded bigquery-key.json)
# GOOGLE_CREDENTIALS_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=

# Google Drive parent folder for MKT report sync
# GOOGLE_DRIVE_PARENT_FOLDER_ID=1abc...xyz
