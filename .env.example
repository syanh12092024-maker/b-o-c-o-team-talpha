# --- API SECURITY ---
FAOS_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- BOTCAKE AI — SPIRITUAL SHOP (Tượng Phật / Lucky Charm) ---
