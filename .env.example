# FAOS — Environment Config Template
# ⚠️ Copy this file to .env and fill in actual values
# ⚠️ NEVER commit .env with real credentials
# ═══════════════════════════════════════════════════════

# --- 1. GOOGLE CLOUD & BIGQUERY ---
GOOGLE_APPLICATION_CREDENTIALS=bigquery_key.json
BQ_PROJECT_ID=levelup-465304
BQ_DATASET=STRAMARK_Dataset
BQ_LOCATION=US

# --- 2. META ADS (FACEBOOK) — STRAMARK ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_PIXEL_ID=
META_AD_ACCOUNT_IDS=act_xxx,act_yyy

# --- 3. POSCAKE — STRAMARK ---
POSCAKE_API_URL=https://pos.pages.fm/api/v1
POSCAKE_API_KEY=
POSCAKE_SHOP_ID=

# --- 4. COMMUNICATION ---
DISCORD_WEBHOOK_REPORT=
DISCORD_WEBHOOK_ALERT=
DISCORD_WEBHOOK_ETL=

# --- 5. N8N ---
N8N_HOST=
N8N_API_KEY=

# --- 6. AGENT CONFIG ---
ENV=dev
LOG_LEVEL=INFO
PROJECT_ID=auus1
PROJECT_CURRENCY=USD
CURRENCY_DIVISOR=100

# --- 7. LLM / AI MODELS ---
GEMINI_API_KEY=
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE=0.3
OPENAI_API_KEY=

# --- 8. AUUS1 PROJECT CREDENTIALS ---
AUUS1_META_APP_ID=
AUUS1_META_APP_SECRET=
AUUS1_META_ACCESS_TOKEN=
AUUS1_POSCAKE_US_KEY=
AUUS1_POSCAKE_AU_KEY=

# --- TELEGRAM BOT ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ROI REAL-TIME ALERT ---
ROI_ALERT_ENABLED=true
ROI_CHECK_INTERVAL_MINUTES=30
ROI_MIN_SPEND_USD=20
ROI_DANGER_THRESHOLD=1.5
ROI_SCALE_THRESHOLD=4.0
ROI_ALERT_COOLDOWN_HOURS=4

# --- MORNING BRIEFING ---
BRIEFING_ENABLED=true
BRIEFING_HOUR_UTC=1
# 1am UTC = 8am ICT (GMT+7)

# --- 9. T1 PROJECT CREDENTIALS ---
T1_META_APP_ID=
T1_META_APP_SECRET=
T1_META_ACCESS_TOKEN=
T1_PANCAKE_API_TOKEN=
T1_PANCAKE_SHOP_ID=
T1_FFM_API_TOKEN=

# --- 10. STRAMARK POS & FULFILLMENT CREDENTIALS ---
STRAMARK_FFM_USERNAME=
STRAMARK_FFM_PASSWORD=
STRAMARK_FFM_API_TOKEN=
STRAMARK_FFM_API_TOKEN_2=
EU_SHIPMENT_CLIENT_ID_NEW=3282

# --- 15. VPS DEPLOY (scripts/deploy_vps.py) ---
# Used by scripts/deploy_vps.py — never commit real values
VPS_HOST=
VPS_USER=root
VPS_PASS=
# Or use key-based auth (recommended). Path to private key on local machine:
VPS_SSH_KEY=
VPS_PROJECT_DIR=/opt/faos

# --- 11. ZEN8 PROJECT CREDENTIALS ---
ZEN8_META_ACCESS_TOKEN=
ZEN8_POSCAKE_API_KEY=
ZEN8_POSCAKE_SHOP_ID=
ZEN8_DISCORD_WEBHOOK=

# --- 12. TRENDIFY (SRN) PROJECT CREDENTIALS ---
TRENDIFY_META_ACCESS_TOKEN=
TRENDIFY_POSCAKE_API_KEY=
TRENDIFY_POSCAKE_SHOP_ID=
TRENDIFY_DISCORD_WEBHOOK=

# --- 13. HNLE PROJECT CREDENTIALS ---
HNLE_META_ACCESS_TOKEN=
HNLE_POSCAKE_API_KEY=
HNLE_POSCAKE_SHOP_ID=
HNLE_POSCAKE_API_KEY_ME=
HNLE_POSCAKE_SHOP_ID_ME=
HNLE_DISCORD_WEBHOOK=

# --- 14. TALPHA PROJECT CREDENTIALS ---
TALPHA_POSCAKE_SA_KEY=
TALPHA_POSCAKE_AE_KEY=
TALPHA_POSCAKE_KW_KEY=
TALPHA_POSCAKE_OM_KEY=
TALPHA_POSCAKE_QA_KEY=
TALPHA_POSCAKE_BH_KEY=
