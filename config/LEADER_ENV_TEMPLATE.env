# ═══════════════════════════════════════════════════════════════════════
# FAOS v6 — LEADER PROJECT CONFIGURATION GUIDE
# ═══════════════════════════════════════════════════════════════════════
#
# 📌 HƯỚNG DẪN CHO LEADER:
#
# 1. Copy file này thành .env.project trong thư mục gốc
#    (KHÔNG thay thế file .env gốc — file gốc là của Core system)
# 2. Điền TOÀN BỘ các trường có dấu ← ĐIỀN
# 3. Source file này khi chạy pipeline của dự án
# 4. KHÔNG COMMIT file .env.project lên Git
#
# ═══════════════════════════════════════════════════════════════════════


# ┌─────────────────────────────────────────────────────┐
# │  SECTION 1: THÔNG TIN DỰ ÁN (BẮT BUỘC)            │
# └─────────────────────────────────────────────────────┘

# Tên dự án (viết thường, không dấu, không space)
# Ví dụ: auus1, zen8, project3, project4
PROJECT_ID=                                # ← ĐIỀN (vd: auus1)

# Đơn vị tiền tệ của dự án
# VND, USD, EUR, RON, ...
PROJECT_CURRENCY=VND                       # ← ĐIỀN

# Hệ số chia tiền (1 = full unit, 100 = cents/bani)
# VND/USD thường = 1, RON = 100 (bani)
CURRENCY_DIVISOR=1                         # ← ĐIỀN


# ┌───────────────────────────────── ────────────────────┐
# │  SECTION 2: GOOGLE CLOUD & BIGQUERY                 │
# └─────────────────────────────────────────────────────┘

# GCP Project (dùng chung, KHÔNG ĐỔI)
GCP_PROJECT_ID=levelup-465304

# BigQuery Dataset RIÊNG cho dự án
# Format: [TÊN_DỰ_ÁN]_Dataset (viết hoa chữ cái đầu)
# Ví dụ: AUUS1_Dataset, ZEN8_Dataset
BQ_DATASET=                                # ← ĐIỀN (vd: AUUS1_Dataset)
BQ_LOCATION=US

# File credential BigQuery (Boss cấp riêng cho từng dự án)
# File đặt trong thư mục config/
# ⚠️ KHÔNG SHARE file này cho bất kỳ ai ngoài team
GOOGLE_APPLICATION_CREDENTIALS=config/bigquery_key_PROJECT.json  # ← ĐỔI "PROJECT" thành tên dự án (vd: bigquery_key_auus1.json)


# ┌─────────────────────────────────────────────────────┐
# │  SECTION 3: META / FACEBOOK ADS                     │
# └─────────────────────────────────────────────────────┘
# Chỉ điền nếu dự án CÓ chạy Facebook Ads
# Nếu không chạy Ads → bỏ qua section này

# Facebook App credentials (lấy từ developers.facebook.com)
META_APP_ID=                               # ← ĐIỀN (nếu có)
META_APP_SECRET=                           # ← ĐIỀN (nếu có)

# Access Token của dự án
# ⚠️ Token hết hạn sau ~60 ngày, cần renew!
# Lấy từ: Business Manager → System Users → Generate Token
META_ACCESS_TOKEN=                         # ← ĐIỀN (nếu có)

# Business Manager ID
META_BUSINESS_ID=                          # ← ĐIỀN (nếu có)

# Pixel ID (cho Conversions API - CAPI)
META_PIXEL_ID=                             # ← ĐIỀN (nếu có)

# Ad Account IDs (phân cách bằng dấu phẩy)
# Format: act_XXXXXXXXXXXX
META_AD_ACCOUNT_IDS=                       # ← ĐIỀN (vd: act_123456789,act_987654321)


# ┌─────────────────────────────────────────────────────┐
# │  SECTION 4: POS SYSTEM (Nguồn dữ liệu đơn hàng)   │
# └─────────────────────────────────────────────────────┘
# Điền thông tin hệ thống POS mà dự án đang dùng

# Loại POS: pancake / sapo / shopee / haravan / kiotviet / other
POS_TYPE=                                  # ← ĐIỀN (vd: pancake)

# API Key hoặc Token của POS
POS_API_KEY=                               # ← ĐIỀN
POS_API_SECRET=                            # ← ĐIỀN (nếu có)

# API Base URL của POS
# Pancake: https://pos.pages.fm/api/v1
# Sapo: https://{store}.mysapo.net/admin
# KiotViet: https://{store}.kiotviet.vn/api
POS_API_URL=                               # ← ĐIỀN

# Store/Shop ID (nếu POS yêu cầu)
POS_SHOP_ID=                               # ← ĐIỀN (nếu có)


# ┌─────────────────────────────────────────────────────┐
# │  SECTION 5: 3PL / LOGISTICS (Vận chuyển)           │
# └─────────────────────────────────────────────────────┘
# Điền nếu dự án tích hợp đối tác vận chuyển

# Loại 3PL: ghn / ghtk / jt / viettelpost / other
LOGISTICS_TYPE=                            # ← ĐIỀN (nếu có)

# API credentials
LOGISTICS_API_KEY=                         # ← ĐIỀN (nếu có)
LOGISTICS_API_URL=                         # ← ĐIỀN (nếu có)
LOGISTICS_SHOP_ID=                         # ← ĐIỀN (nếu có)


# ┌─────────────────────────────────────────────────────┐
# │  SECTION 6: AI / LLM (Dùng chung hoặc riêng)      │
# └─────────────────────────────────────────────────────┘
# Nếu dự án có API key AI riêng thì điền ở đây
# Nếu dùng chung key với Core → hỏi Boss

OPENAI_API_KEY=                            # ← ĐIỀN hoặc hỏi Boss
GEMINI_API_KEY=                            # ← ĐIỀN hoặc hỏi Boss
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-2.5-flash-preview


# ┌─────────────────────────────────────────────────────┐
# │  SECTION 7: NOTIFICATION (Tuỳ chọn)                │
# └─────────────────────────────────────────────────────┘
# Kênh thông báo riêng cho dự án (nếu cần)

# Telegram Bot riêng (tạo tại https://t.me/BotFather)
PROJECT_TELEGRAM_BOT_TOKEN=                # ← ĐIỀN (nếu có)
PROJECT_TELEGRAM_CHAT_ID=                  # ← ĐIỀN (nếu có)

# Discord Webhook riêng
PROJECT_DISCORD_WEBHOOK=                   # ← ĐIỀN (nếu có)


# ┌─────────────────────────────────────────────────────┐
# │  SECTION 8: SCHEDULING (Lịch chạy tự động)         │
# └─────────────────────────────────────────────────────┘
# Cron expressions cho pipeline sync

# Sync đơn hàng POS (mặc định: 7:45 sáng mỗi ngày)
SYNC_ORDERS_CRON=45 7 * * *               # ← CHỈNH nếu cần

# Sync dữ liệu Ads (mặc định: 8:00 sáng mỗi ngày)
SYNC_ADS_CRON=0 8 * * *                   # ← CHỈNH nếu cần

# Timezone
TZ=Asia/Ho_Chi_Minh


# ═══════════════════════════════════════════════════════
# ⚠️ CHECKLIST TRƯỚC KHI BẮT ĐẦU:
# ═══════════════════════════════════════════════════════
#
# [ ] PROJECT_ID đã điền
# [ ] BQ_DATASET đã điền (format: [TÊN]_Dataset)
# [ ] bigquery_key.json đã nhận từ Boss và đặt trong thư mục gốc
# [ ] META credentials đã điền (nếu chạy Ads)
# [ ] POS credentials đã điền (nếu có POS)
# [ ] LLM API keys đã điền hoặc xác nhận dùng chung với Boss
# [ ] File này đã rename thành .env.project
# [ ] File này KHÔNG được commit lên Git
#
# ═══════════════════════════════════════════════════════
